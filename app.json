{
  "expo": {
    "name": "Sugar Tracker",
    "slug": "sugar-tracker",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/android/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.himanshu.sugartracker",
      "adaptiveIcon": {
        "backgroundColor": "#0969da",
        "foregroundImage": "./assets/android/adaptive-foreground.png",
        "monochromeImage": "./assets/android/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/android/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android/adaptive-foreground.png",
          "color": "#0969da"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "104fd15b-efd5-421f-bcba-410fa2d5a9ba"
      }
    }
  }
}
